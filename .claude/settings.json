{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_BASE_VENDOR=claude bash \"${CLAUDE_PROJECT_DIR}/ai-venture-guard.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^av-low-helper$",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTE=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] || ROUTE=\"${CLAUDE_PROJECT_DIR}/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] || ROUTE=\"${CLAUDE_PROJECT_DIR}/template/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] && python3 \"$ROUTE\" claude-hook || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^av-low-helper$",
        "hooks": [
          {
            "type": "command",
            "command": "ROUTE=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] || ROUTE=\"${CLAUDE_PROJECT_DIR}/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] || ROUTE=\"${CLAUDE_PROJECT_DIR}/template/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] && python3 \"$ROUTE\" claude-hook || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STRIP=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/permission-auto-strip.sh\"; [[ -f \"$STRIP\" ]] && bash \"$STRIP\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "CHECK=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/check-git-state-claim.py\"; [[ -f \"$CHECK\" ]] && python3 \"$CHECK\" claude || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CHECK=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/check-pending-migrations.sh\"; [[ -f \"$CHECK\" ]] && bash \"$CHECK\" || true"
          },
          {
            "type": "command",
            "command": "CHECK=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/check-safe-001-reminder.sh\"; [[ -f \"$CHECK\" ]] && bash \"$CHECK\" || true"
          },
          {
            "type": "command",
            "command": "CHECK=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/check-git-commit-format-reminder.sh\"; [[ -f \"$CHECK\" ]] && bash \"$CHECK\" || true"
          },
          {
            "type": "command",
            "command": "CHECK=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/check-staffing-recovery.sh\"; [[ -f \"$CHECK\" ]] && bash \"$CHECK\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CHECK=\"${CLAUDE_PROJECT_DIR}/_sub/ai-venture/template/scripts/check-credential-repo-boundary-claude.sh\"; [[ -f \"$CHECK\" ]] && bash \"$CHECK\" || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git -C _sub/ai-venture fetch:*)",
      "Bash(git -C _sub/ai-venture checkout:*)",
      "Bash(git -C _sub/ai-venture branch -f:*)",
      "Bash(bash ai-venture-guard.sh)",
      "Bash(bash scripts/markdown-lint.sh:*)",
      "Bash(python3 scripts/human-interruptions.py status)",
      "Bash(python3 scripts/human-interruptions.py report:*)",
      "Bash(python3 scripts/human-interruptions.py recommend:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "Skill(permission-promote)",
      "Skill(permission-promote:*)",
      "Bash(git pull:*)"
    ],
    "deny": [
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git revert:*)",
      "Bash(git switch:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "Bash(git tag -f:*)",
      "Bash(git tag --force:*)"
    ]
  }
}
