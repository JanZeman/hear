{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [[ -n \"$ROOT\" && -f \"$ROOT/ai-venture-guard.sh\" ]] && AI_VENTURE_VENDOR=codex bash \"$ROOT/ai-venture-guard.sh\" || true'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^av-low-helper$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; ROUTE=\"$ROOT/_sub/ai-venture/template/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] || ROUTE=\"$ROOT/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] && python3 \"$ROUTE\" codex-hook || true'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^av-low-helper$",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; ROUTE=\"$ROOT/_sub/ai-venture/template/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] || ROUTE=\"$ROOT/scripts/route-receipts.py\"; [[ -f \"$ROUTE\" ]] && python3 \"$ROUTE\" codex-hook || true'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [[ -n \"$ROOT\" && -f \"$ROOT/_sub/ai-venture/template/scripts/check-pending-migrations-codex.sh\" ]] && bash \"$ROOT/_sub/ai-venture/template/scripts/check-pending-migrations-codex.sh\" || true'"
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [[ -n \"$ROOT\" && -f \"$ROOT/_sub/ai-venture/template/scripts/check-safe-001-reminder-codex.sh\" ]] && bash \"$ROOT/_sub/ai-venture/template/scripts/check-safe-001-reminder-codex.sh\" || true'"
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [[ -n \"$ROOT\" && -f \"$ROOT/_sub/ai-venture/template/scripts/check-git-commit-format-reminder-codex.sh\" ]] && bash \"$ROOT/_sub/ai-venture/template/scripts/check-git-commit-format-reminder-codex.sh\" || true'"
          },
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [[ -n \"$ROOT\" && -f \"$ROOT/_sub/ai-venture/template/scripts/check-staffing-recovery-codex.sh\" ]] && bash \"$ROOT/_sub/ai-venture/template/scripts/check-staffing-recovery-codex.sh\" || true'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [[ -n \"$ROOT\" && -f \"$ROOT/_sub/ai-venture/template/scripts/check-credential-repo-boundary-codex.sh\" ]] && bash \"$ROOT/_sub/ai-venture/template/scripts/check-credential-repo-boundary-codex.sh\" || true'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; CHECK=\"$ROOT/_sub/ai-venture/template/scripts/check-git-state-claim.py\"; [[ -n \"$ROOT\" && -f \"$CHECK\" ]] && python3 \"$CHECK\" codex || true'"
          }
        ]
      }
    ]
  }
}
